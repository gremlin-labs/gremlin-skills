{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gremlin.skills/schemas/seo-setup-status.schema.json",
  "title": "SEO Setup integrated status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "generated_at", "canonical_origin", "overall_status", "requirements", "credential_sources", "artifact_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "canonical_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
    "overall_status": {"type": "string", "enum": ["VERIFIED", "INCOMPLETE"]},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "credential_sources": {"type": "array", "items": {"$ref": "#/$defs/credential_source"}},
    "artifact_paths": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"overall_status": {"const": "VERIFIED"}}},
      "then": {
        "properties": {
          "requirements": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/requirement"},
                {"properties": {"status": {"enum": ["VERIFIED", "NOT_APPLICABLE"]}}}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "group", "required", "status", "summary", "evidence", "verified_at", "source", "user_action", "not_applicable_reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "group": {
          "type": "string",
          "enum": ["production_identity", "crawl_index", "ga4", "google_search_console", "google_ads_keyword_planner", "bing_webmaster", "documentation"]
        },
        "required": {"type": "boolean"},
        "status": {"type": "string", "enum": ["VERIFIED", "NOT_APPLICABLE", "AWAITING_USER_ACTION", "BLOCKED", "FAILED"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "source": {"type": "string", "enum": ["repository", "live_http", "api", "computer_use", "user_evidence", "manual_test"]},
        "user_action": {"type": ["string", "null"]},
        "not_applicable_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "VERIFIED"}}},
          "then": {
            "properties": {
              "evidence": {"minItems": 1},
              "verified_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "NOT_APPLICABLE"}}},
          "then": {"properties": {"not_applicable_reason": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "AWAITING_USER_ACTION"}}},
          "then": {"properties": {"user_action": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "credential_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kind", "present"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "present": {"type": "boolean"}
      }
    }
  }
}
